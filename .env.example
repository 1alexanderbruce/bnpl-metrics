# Copy to .env and fill in. Never commit .env.

# Required for LLM-assisted extraction: key for an OpenAI-compatible provider
LLM_API_KEY=your-api-key-here

# Optional: any OpenAI-compatible endpoint (default: OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# Required by SEC EDGAR and used for all web requests: identify yourself,
# e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=your-name your-email@example.com

# Optional: outbound proxy (standard variables are honored)
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: where results and downloads are stored (default: ./cache and ./data)
# BNPL_METRICS_CACHE_DIR=cache
# BNPL_METRICS_DATA_DIR=data

# Optional: dashboard
# BNPL_METRICS_PORT=7862
# BNPL_METRICS_SHARE=0
